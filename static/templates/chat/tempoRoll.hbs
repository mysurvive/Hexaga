<div class="hexaga-test-roll" data-actor-id="{{actorId}}">
    <div class="roll-title">
        {{title}}
    </div>
    <hr />

    <div class="roll-modifiers">
        {{#each modifierTrace}}
            <div class="modifier-trace">{{this.label}} {{this.value}}</div>
        {{/each}}
    </div>

    <div class="dice-formula">
        {{formula}}
    </div>

    <div class="all-rolls">
        {{#each diceList}}
            <div class="die">
                {{this}}
            </div>
        {{/each}}
    </div>
</div>