<div>
    <header class="actor-header">
        <img class="character-portrait" src="{{actor.img}}" />
        <div class="character-basics">
            <div>
                <label for="character-name">Name: </label>
                <input type="text" id="character-name" value="{{actor.name}}" data-attribute="name" />
            </div>
            <div>
                <label for="character-heritage">Heritage: </label>
                <span id="character-heritage">{{actor.system.options.heritage.name}}</span>
            </div>
            <div>
                <label for="character-profession">Profession: </label>
                <span id="character-profession">{{actor.system.options.profession.name}}</span>
            </div>

            <div class="character-intrinsic">
                <div>
                    <label for="current-hp">HP: </label>
                    <input type="number" id="current-hp" value="{{actor.hp.current}}" />
                    <span>/
                        {{actor.hp.max}}</span>
                </div>
                <div>
                    <label for="character-tempo">Tempo: </label>
                    <span id="character-tempo">{{actor.intrinsics.tempo}}</span>
                </div>
                <div>
                    <label for="character-speed">Speed: </label>
                    <span id="character-speed">{{actor.intrinsics.speed}}</span>
                </div>
            </div>
        </div>
        <div class="focus-box-container medium" id="character-level">
            <div class="focus-label">Level</div>
            <div class="focus-content">
                {{actor.system.level}}
            </div>
        </div>
    </header>
    <nav class="sheet-tabs tabs">
        {{#each tabs as |tab|}}
            <a class="{{tab.cssClass}}" data-action="tab" data-group="{{tab.group}}" data-tab="{{tab.id}}">
                <label>{{localize tab.label}}</label>
            </a>
        {{/each}}
    </nav>

    <section class="tab {{tabs.aspects.cssClass}}" data-group="primary" data-tab="aspects">
        xxxx
    </section>
    <section class="tab {{tabs.spells.cssClass}}" data-group="primary" data-tab="spells">
        yyyy
    </section>
</div>