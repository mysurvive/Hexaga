<section class="tab {{tabs.character.cssClass}}" data-group="primary" data-tab="character">
    {{#each attributeGroups}}
        <div class="attribute-group" id="{{@key}}">
            <div class="attribute-group-label">
                {{localize label}}
            </div>
            <div class="attribute-group-body">
                <div class="defenses">
                    <div id="{{@key}}-rv">
                        <div class="focus-box-container medium">
                            <div class="focus-label">RV</div>
                            <div class="focus-content">
                                {{lookup (lookup @root.actor.rv @key) "total"}}
                            </div>
                        </div>
                    </div>
                    <div id="{{@key}}-resist">

                    </div>
                </div>
                <div class="attribute-area">
                    {{#each attributes}}
                        <div class="attribute-content">
                            <div class="focus-box-container large" data-tooltip="{{breakdown}}">
                                <div class="focus-label">
                                    {{localize label}}
                                </div>
                                <div class="focus-content">
                                    {{rank}}
                                </div>
                            </div>
                            <div class="skill-area">
                                {{#each skills}}
                                    <div class="skill-item" id="{{@key}}">
                                        <span>{{localize label}}</span>
                                        <div class="focus-box-container small">
                                            <div class="focus-content">{{rank}}</div>
                                        </div>
                                        <div class="focus-box-container small" data-tooltip="{{breakdown}}">
                                            <div class="focus-content">{{total}}{{#unless trained}}*{{/unless}}</div>
                                        </div>
                                        <button class="roll-button" data-action="rollSkill" data-skill="{{@key}}"><i
                                                class="fa-solid fa-dice-six"
                                            ></i>
                                        </button>
                                    </div>
                                {{/each}}
                            </div>
                        </div>
                    {{/each}}
                </div>
            </div>
        </div>
    {{/each}}
    <div class="attribute-group" id="expertise">
        <div class="attribute-group-label">
            {{localize "hexaga.expertise.label"}}
        </div>
    </div>
</section>