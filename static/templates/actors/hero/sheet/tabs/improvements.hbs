<section class="tab {{tabs.improvements.cssClass}}" data-group="primary" data-tab="improvements">
    <div class="title-left">
        <span>Heritage</span>
        <hr />
    </div>
    {{#with options.heritage}}
        <details class="improvement-item">
            <summary><span>{{name}}</span>
                {{#unless flags.hexaga.selections}}<span>Improvement Available!</span>{{/unless}}</summary>
            <div class="content">
                <div>{{{system.description}}}</div>
                <div class="options">
                    {{#each system.improvements.attributes.selected}}
                        <label class="labeled-toggle">
                            <input type="radio" name="heritage-attributes" value="{{this}}" />
                            <span class="label-button">{{localize (concat "hexaga.attributes." this ".label")}}</span>
                        </label>
                    {{/each}}
                </div>
            </div>
        </details>
    {{else}}
        <div class="improvement-item empty item-drop" data-drop-type="heritage">
            Drag a Heritage here!
        </div>
    {{/with}}

    {{#each improvements.taken}}{{/each}}

</section>