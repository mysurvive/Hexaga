<section class="tab {{tabs.config.cssClass}}" data-group="primary" data-tab="foundational">
    <div class="foundational-improvements">
        {{#each improvements as |improvement|}}
            <div class="foundational-item">
                <div class="title">{{localize (concat "hexaga." @key ".label")}}</div>
                <hr />
                {{#each choices as |choice|}}
                    <input type="checkbox" id="{{choice}}" name="{{@../key}}" value="true"/>
                    <label for="{{choice}}">{{localize (concat "hexaga." @../key "." choice ".label")}}</label>
                {{/each}}
            </div>
        {{/each}}
    </div>
</section>