<section class="tab {{tabs.config.cssClass}}" data-group="primary" data-tab="foundational">
    <div class="foundational-improvements">
        {{#with improvements.attributes}}
            <div class="foundational-item">
                <div class="title">{{localize "hexaga.attributes.label"}}</div>
                <hr />
                <div class="choices">
                {{#each choices as |choice|}}
                <div class="flex align-center">
                    <input type="checkbox" id="{{choice}}" name="attributes" value="{{choice}}" {{#includes @root.improvements.attributes.selected (choice)}}checked{{/includes}}/>
                    <label for="{{choice}}">{{localize (concat "hexaga.attributes." choice ".label")}}</label>
                </div>
                {{/each}}
                </div>
            </div>
        {{/with}}
    </div>
</section>